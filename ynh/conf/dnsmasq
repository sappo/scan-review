# Answer LAN clients for __DOMAIN__, so it resolves to this host's LAN address
# instead of its public one. Written by the scanpipe app; removed when it is.
#
# Without this, a LAN client resolves __DOMAIN__ via public DNS, gets the WAN
# address, leaves through the router and comes back - and a NAT that rewrites
# the source makes the request look like it came from the internet, so the
# LAN-only restriction refuses it.

# Explicit addresses, NOT `interface=`. The LAN interface usually also carries
# a public IPv6, and YunoHost's firewall permits udp/53 - binding the whole
# interface would publish an open resolver to the internet.
listen-address=127.0.0.1
listen-address=::1
listen-address=__LAN_IP__

# bind-dynamic rather than bind-interfaces: it tolerates the address appearing
# after dnsmasq starts, so a boot-order race cannot leave the host without DNS.
bind-dynamic

# NOTE: this file cannot shape the ANSWER, only where dnsmasq listens.
#
# YunoHost already publishes `interface-name=__DOMAIN__,<iface>` for this
# domain, and interface-name takes ABSOLUTE precedence in dnsmasq - verified
# against 2.90: neither `address=` nor `host-record=`, in either load order,
# overrides it. So the A answer below comes from YunoHost's record, which
# happens to be exactly what is wanted: the interface address, i.e. the LAN IP.
#
# The consequence is that AAAA cannot be suppressed for this name either.
# interface-name answers with EVERY address on the interface, including the
# public IPv6, and RFC 6724 makes clients prefer a global IPv6 (precedence 40)
# over IPv4 (35) over a ULA (3). So an IPv6-capable client will reach this host
# on its public address and appear to come from outside the LAN.
#
# dnsmasq 2.90 has only a GLOBAL --filter-AAAA, which would strip IPv6 from
# every answer this resolver gives to the whole network - too broad to use for
# one name. Whether that matters therefore depends on the LAN restriction:
# either it must permit the IPv6 ranges clients actually arrive from, or the
# clients must be IPv4-only.
