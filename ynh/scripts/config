#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

ynh_app_config_apply() {
    # Persist the answers first, then rebuild what depends on them. Without
    # this override the core would store the setting and change nothing, so the
    # toggle would appear to work and have no effect.
    _ynh_app_config_apply

    # Re-render everything the answers feed, not just nginx. lan_dns was
    # accepted here but never applied, so the toggle stored a setting and
    # changed nothing - which is the exact failure this override exists to
    # prevent, reintroduced one setting later.
    set_lan_access
    configure_lan_dns
    ynh_config_add_nginx
}

ynh_app_config_run "$1"
