# Copy to deploy.env and fill in for your machine. deploy.env is gitignored.
#
# Once installed as a YunoHost app, the app's config panel is the system of
# record for the network restriction and the scanner token; these are the
# values needed before that, and at install time.

SCANPIPE_SCANNER_HOST=rpi@192.168.1.20
SCANPIPE_DEPLOY_DOMAIN=scans.example.org
SCANPIPE_DEPLOY_LAN_SUBNET=192.168.1.0/24
